---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "2024 - Present",
    title: "Part-time Teacher",
    company: "Golden Success College",
    description:
      "Instructing students in Information Technology subjects, fostering a deep understanding of core concepts and practical applications. I develop curriculum materials, guide students through hands-on programming exercises, and mentor them in modern software development practices.",
  },
  {
    date: "2023 - 2024",
    title: "IOT Capstone Project",
    company: "Capstone Project",
    description:
      "Frontend Developer & Backend Contributor. Developed a comprehensive IOT system using Angular, Bootstrap, and TypeScript for the frontend interface. Implemented a robust backend architecture using Express, Sequelize, and MySQL to handle data processing and device communication.",
  },
];
---

<div class="relative max-md:mt-0 mt-8" aria-label="Professional experience">
  <ol class="relative mt-10">
    {
      EXPERIENCE.map((experience, index) => (
        <li class="">
          <article role="article" aria-labelledby={`experience-title-${index}`}>
            <div
              class="flex flex-col gap-2  text-zinc-00 dark:text-zinc-300 md:col-span-3"
              aria-describedby={`experience-title-${index}`}
            >
              <ExperienceItem {...experience} />
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</div>
